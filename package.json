{
  "name": "metrika",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "codegen": "pnpm --filter @metrika/codegen run generate",
    "verify": "pnpm --filter @metrika/codegen run verify",
    "typecheck": "tsc --build --force",
    "test": "pnpm -r --sequential run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content-lint": "node scripts/content-lint.mjs",
    "build": "pnpm --filter @metrika/app run build && pnpm --filter @metrika/app run build:portable",
    "check:tauri": "node scripts/check-tauri-config.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.0",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "5.0.1"
  }
}
