{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetriKa",
  "version": "0.1.0",
  "identifier": "id.ac.local.metrika",
  "build": {
    "frontendDist": "../../../docs",
    "beforeBuildCommand": "pnpm --filter @metrika/app run build",
    "beforeDevCommand": "pnpm --filter @metrika/app run dev",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "MetriKa",
        "width": 980,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "category": "Education",
    "shortDescription": "Quantitative marketing analysis workbench",
    "longDescription": "MetriKa computes 76 quantitative marketing formulas from the numbers a user enters. It runs with the network disabled and keeps all data on the user's own device.",
    "copyright": "MIT",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Indonesian"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": []
    }
  }
}
